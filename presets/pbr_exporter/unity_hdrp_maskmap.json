{
  "schema_type": "omnimesh_pbr_export",
  "name": "Unity HDRP (MaskMap)",
  "version": 2,
  "description": "Unity High Definition Render Pipeline packed MaskMap template",
  "target_engine": "UNITY_6",
  "strategy": "CONVERT_PNG",
  "bit_depth": 16,
  "naming_pattern": "{material}{suffix}",
  "maps": [
    {
      "id": "base_color",
      "name": "Base Color",
      "export_suffix": "_BaseColor",
      "color_space": "sRGB",
      "channels": {
        "rgb": {
          "target": "Base Color",
          "invert": false
        },
        "a": {
          "target": "Alpha",
          "invert": false
        }
      }
    },
    {
      "id": "maskmap",
      "name": "MaskMap (Metal, AO, Detail, Smoothness)",
      "export_suffix": "_MaskMap",
      "color_space": "Non-Color",
      "channels": {
        "r": {
          "target": "Metallic",
          "invert": false,
          "default": 0.0
        },
        "g": {
          "target": "Ambient Occlusion",
          "invert": false,
          "default": 1.0
        },
        "b": {
          "target": "Detail Mask",
          "invert": false,
          "default": 0.0
        },
        "a": {
          "target": "Roughness",
          "invert": true,
          "default": 0.5
        }
      }
    },
    {
      "id": "normal",
      "name": "Normal Map (OpenGL)",
      "export_suffix": "_Normal",
      "color_space": "Non-Color",
      "normal_format": "OPENGL",
      "channels": {
        "rgb": {
          "target": "Normal",
          "invert": false
        }
      }
    },
    {
      "id": "emissive",
      "name": "Emissive",
      "export_suffix": "_Emissive",
      "color_space": "sRGB",
      "channels": {
        "rgb": {
          "target": "Emission Color",
          "invert": false
        }
      }
    }
  ]
}