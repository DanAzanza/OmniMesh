{
  "schema_type": "omnimesh_pbr_export",
  "name": "MSFS 2024 (glTF COMP)",
  "version": 2,
  "description": "Microsoft Flight Simulator 2024 glTF composite texture template",
  "target_engine": "MSFS_2024",
  "strategy": "CONVERT_PNG",
  "bit_depth": 8,
  "naming_pattern": "{material}{suffix}",
  "maps": [
    {
      "id": "albedo",
      "name": "Albedo",
      "export_suffix": "_ALBEDO",
      "color_space": "sRGB",
      "channels": {
        "rgb": {
          "target": "Base Color",
          "invert": false
        },
        "a": {
          "target": "Alpha",
          "invert": false
        }
      }
    },
    {
      "id": "comp",
      "name": "Composite (Occlusion, Roughness, Metallic)",
      "export_suffix": "_COMP",
      "color_space": "Non-Color",
      "channels": {
        "r": {
          "target": "Ambient Occlusion",
          "invert": false,
          "default": 1.0
        },
        "g": {
          "target": "Roughness",
          "invert": false,
          "default": 0.5
        },
        "b": {
          "target": "Metallic",
          "invert": false,
          "default": 0.0
        }
      }
    },
    {
      "id": "normal",
      "name": "Normal Map (DirectX)",
      "export_suffix": "_NORM",
      "color_space": "Non-Color",
      "normal_format": "DIRECTX",
      "channels": {
        "rgb": {
          "target": "Normal",
          "invert": false
        }
      }
    },
    {
      "id": "emissive",
      "name": "Emissive",
      "export_suffix": "_EMISSIVE",
      "color_space": "sRGB",
      "channels": {
        "rgb": {
          "target": "Emission Color",
          "invert": false
        }
      }
    }
  ]
}